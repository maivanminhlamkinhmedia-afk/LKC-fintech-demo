generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_MANAGER
  SALES
  CREATOR
  ANALYST
  EMPLOYEE
  CLIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  DORMANT
  CLOSED
}

enum CustomerPriority {
  LOW
  MEDIUM
  HIGH
}

enum CustomerActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  MESSAGE
  STATUS_CHANGE
  ASSIGNMENT
}

enum CustomerTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CustomerTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String
  password    String
  phone       String?
  role        Role       @default(CLIENT)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customerProfile   CustomerProfile?
  assignedCustomers CustomerProfile[] @relation("AssignedSales")

  salesTeamsManaged SalesTeam[]       @relation("SalesTeamManager")
  salesMemberships  SalesTeamMember[]

  customerActivities    CustomerActivity[] @relation("CustomerActivityActor")
  customerTasksAssigned CustomerTask[]     @relation("CustomerTaskAssignee")
  customerTasksCreated  CustomerTask[]     @relation("CustomerTaskCreator")

  auditLogs AuditLog[] @relation("AuditActor")

  @@index([role, status])
}

model CustomerProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  assignedSalesId String?
  customerCode    String           @unique
  status          CustomerStatus   @default(LEAD)
  priority        CustomerPriority @default(MEDIUM)
  source          String?
  note            String?          @db.Text
  lastContactAt   DateTime?
  nextContactAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedSales User? @relation("AssignedSales", fields: [assignedSalesId], references: [id], onDelete: SetNull)

  activities CustomerActivity[]
  tasks      CustomerTask[]

  @@index([assignedSalesId, status])
  @@index([priority, status])
  @@index([nextContactAt])
}

model SalesTeam {
  id        String   @id @default(cuid())
  name      String
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager User              @relation("SalesTeamManager", fields: [managerId], references: [id], onDelete: Restrict)
  members SalesTeamMember[]

  @@index([managerId])
}

model SalesTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([userId])
  @@index([userId])
}

model CustomerActivity {
  id         String               @id @default(cuid())
  customerId String
  actorId    String?
  type       CustomerActivityType
  title      String
  content    String?              @db.Text
  createdAt  DateTime             @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor    User?           @relation("CustomerActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([actorId, createdAt])
}

model CustomerTask {
  id           String               @id @default(cuid())
  customerId   String
  assignedToId String?
  createdById  String
  title        String
  description  String?              @db.Text
  status       CustomerTaskStatus   @default(TODO)
  priority     CustomerTaskPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("CustomerTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("CustomerTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
